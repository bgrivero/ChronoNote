# PostgreSQL Connection (Primary Production & Local Database)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/chrononote

# If local PostgreSQL credentials are not yet configured, fallback to SQLite so dev/tests run seamlessly
AUTO_FALLBACK_SQLITE=true
SQLITE_FALLBACK_URL=sqlite:///./chrononote.db

# CORS & Server Settings
CORS_ORIGINS=*
APP_ENV=development

# Google OAuth & Personal Login (For online personal deployment)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
# Optional comma-separated allowlist of personal Google email(s) allowed to sign in
ALLOWED_GOOGLE_EMAILS=
AUTH_SECRET_KEY=replace-with-a-long-random-secret-string
AUTH_REQUIRED=false
